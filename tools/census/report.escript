#!/usr/bin/env escript
%%! -noshell

main(_) ->
    Root = filename:dirname(filename:dirname(filename:dirname(escript:script_name()))),
    Dir = filename:join([Root,"docs","census"]),
    Names = [bench,boot,hello,elixir,iex,mix],
    Data = [{Name,scenario(Dir,Name)} || Name <- Names],
    BenchImports = bench_imports(Root,Dir),
    Summary = ["# OTP 29.1.1 BIF, NIF, and port census\n\n",
               "Generated by [`tools/census/run_all.sh`](../../tools/census/run_all.sh) on macOS arm64, "
               "using Erlang/OTP 29.1.1 and Elixir 1.20.4-otp-29. "
               "Call counts are observations of these runs, not minimum semantic requirements.\n\n",
               "## Scenarios\n\n",
               "| Scenario | Distinct BIFs | Distinct NIFs | Port opens | Registered processes | ETS tables | Loaded NIF modules |\n"
               "|---|---:|---:|---:|---:|---:|---:|\n",
               [summary_row(Name,D) || {Name,D} <- Data],"\n",
               "The `bench` run calls `fib(25)`, `trees(10)`, `nbody(1000)`, and `tasks(1000)` "
               "from the current `bench/bench.erl`, compiled with `export_all` in `tmp/`. "
               "Its `/proc` RSS read fails on macOS after task spawning; the failure is caught. "
               "The other scenarios use a generated boot script that starts tracing after "
               "`init_kernel_started`, before `application:start_boot(kernel)`. "
               "The `mix` run is `mix test` in a fresh `mix new` project; an ExUnit after-suite "
               "callback flushes the trace.\n\n",
               "## Cumulative implementation queue\n\n",
               cumulative(Data),"\n",
               "## Static coverage for early boot and kernel opcodes\n\n",
               static_coverage(Dir,BenchImports),
               "## BIF calls by scenario\n\n",
               [bif_section(Name,D) || {Name,D} <- Data],
               "## NIF work items\n\n",
               nif_section(Data),
               "## Ports and OS commands\n\n",
               port_section(Data),
               "## Everything shipped\n\n",
               shipped(Dir),
               "## Method and limits\n\n",
               "- `static.csv` reads imports from every OTP and Elixir BEAM. `nifs.csv` merges "
               "OTP `-nifs` declarations from abstract code with `module_info(nifs)` results; "
               "[nif-modules.csv](nif-modules.csv) also records `load_nif/2` imports and "
               "`on_load` attributes. `bif-inventory.csv` contains the "
               "full `bif.tab` set plus imported runtime builtins, including unused entries.\n"
               "- `beam_disasm` checked BIF and GC BIF instructions in `lists`, `maps`, and "
               "`erl_eval` against their import tables. Those uses have imports except for "
               "compiler-generated `raise/2` pseudo-BIFs in `maps` and `erl_eval`.\n"
               "- `erlang:trace_pattern` uses global patterns for builtins, local patterns "
               "for every installed `prim_*` module and `erts_internal`, plus local patterns "
               "for discovered NIF functions. The [prim-modules.csv](prim-modules.csv) "
               "inventory drives that selection. Calls are counted in first-call order. "
               "Guard BIFs and arithmetic compiled into instructions or inlined by the JIT are not "
               "visible to call tracing. Native startup before `init_kernel_started` is also absent.\n"
               "- Port opens are traced through `erts_internal:open_port/2`; port snapshots only "
               "show ports still alive when sampled. The permanent `forker` port is a VM service, "
               "not an `open_port/2` call from BEAM code.\n"
               "- NIF modules listed as loaded in snapshots are broader than NIF functions "
               "actually called. Elixir BEAMs with a custom debug backend expose imports, but "
               "their abstract `-nifs` attributes are unavailable to this Erlang-only scan.\n"
               "- `erlang:halt/0` runs after the trace flush, so it is a required termination "
               "BIF absent from the dynamic CSV. IEx started with `-e` and therefore does not "
               "exercise an interactive TTY session.\n"
               "- The generated boot script and tracer themselves add some calls to the counts. "
               "Boot, hello, Elixir, IEx, and Mix include that tracing overhead; `bench` starts "
               "tracing after ordinary boot.\n"],
    ok = file:write_file(filename:join(Dir,"README.md"),Summary),
    io:format("report: 6 scenarios, ~B README bytes~n",[iolist_size(Summary)]).

scenario(Dir,Name) ->
    Label = atom_to_list(Name),
    Csv = filename:join(Dir,"dynamic-"++Label++".csv"),
    {ok,Bin} = file:read_file(Csv),
    [_|Lines] = string:split(binary_to_list(Bin),"\n",all),
    Rows = [row(Line) || Line <- Lines, Line =/= ""],
    {ok,[Snapshot]} = file:consult(filename:join(Dir,"snapshot-"++Label++"-stop.term")),
    {ok,[PortOpens]} = file:consult(filename:join(Dir,"port-opens-"++Label++".term")),
    #{rows=>Rows,snapshot=>Snapshot,port_opens=>PortOpens}.

row(Line) ->
    [M,F,A,N,K] = string:split(Line,",",all),
    {M,F,list_to_integer(A),list_to_integer(N),K}.

summary_row(Name,Data) ->
    Rows = maps:get(rows,Data),
    Snap = maps:get(snapshot,Data),
    io_lib:format("| [~s](dynamic-~s.csv) | ~B | ~B | ~B | ~B | ~B | ~B |~n",
                  [atom_to_list(Name),atom_to_list(Name),
                   count_kind(Rows,"bif"),count_kind(Rows,"nif"),
                   length(maps:get(port_opens,Data)),
                   length(maps:get(registered,Snap)),length(maps:get(ets,Snap)),
                   length(maps:get(nif_modules,Snap))]).

count_kind(Rows,Kind) -> length([ok || {_,_,_,_,K} <- Rows,K =:= Kind]).

cumulative(Data) ->
    ["Each row adds observed BIFs to the cumulative union; the observed sets "
     "are not mathematically nested.\n\n",
     "| Step | New BIFs | Cumulative BIFs |\n|---|---:|---:|\n",
     cumulative_rows(Data,#{})].

cumulative_rows([],_) -> [];
cumulative_rows([{Name,Data}|Rest],Seen) ->
    Rows = [R || R={_,_,_,_,"bif"} <- maps:get(rows,Data)],
    New = [R || R={M,F,A,_,_} <- Rows,not maps:is_key({M,F,A},Seen)],
    NewSeen = lists:foldl(fun({M,F,A,_,_},Acc)->maps:put({M,F,A},true,Acc) end,Seen,New),
    [io_lib:format("| ~s | ~B | ~B |~n",[atom_to_list(Name),length(New),maps:size(NewSeen)]),
     "\n**New at ",atom_to_list(Name),":** ",mfa_list(New),"\n\n",
     cumulative_rows(Rest,NewSeen)].

mfa_list([]) -> "none";
mfa_list(Rows) ->
    string:join([lists:flatten(io_lib:format("`~s:~s/~B`",[M,F,A])) ||
                    {M,F,A,_,_} <- Rows],", ").

bif_section(Name,Data) ->
    Rows = [R || R={_,_,_,_,"bif"} <- maps:get(rows,Data)],
    Mods = lists:usort([M || {M,_,_,_,_} <- Rows]),
    ["### ",atom_to_list(Name),"\n\n",
     "[Trace CSV](dynamic-",atom_to_list(Name),".csv) in first-call order.\n\n",
     "| Module | BIF calls (function/arity x calls) |\n|---|---|\n",
     [begin
          Calls = [lists:flatten(io_lib:format("`~s/~B` x ~B",[F,A,N])) ||
                      {M0,F,A,N,_} <- Rows, M0 =:= M],
          ["| `",M,"` | ",string:join(Calls,", ")," |\n"]
      end || M <- Mods],"\n"].

nif_section(Data) ->
    ["| Scenario | NIF module | Called NIF functions |\n|---|---|---|\n",
     [begin
          Rows = [R || R={_,_,_,_,"nif"} <- maps:get(rows,D)],
          Mods = lists:usort([M || {M,_,_,_,_} <- Rows]),
          case Mods of
              [] -> io_lib:format("| ~s | none observed | none |~n",[atom_to_list(Name)]);
              _ -> [begin
                        Calls = [lists:flatten(io_lib:format("`~s/~B` x ~B",[F,A,N])) ||
                                     {M0,F,A,N,_} <- Rows,M0 =:= M],
                        io_lib:format("| ~s | `~s` | ~s |~n",
                                      [atom_to_list(Name),M,string:join(Calls,", ")])
                    end || M <- Mods]
          end
      end || {Name,D} <- Data],
     "\nLoaded NIF modules, including modules with no observed NIF calls:\n\n",
     "| Scenario | Loaded NIF modules |\n|---|---|\n",
     [begin
          Snap = maps:get(snapshot,D),
          Mods = ["`"++atom_to_list(M)++"`" || {M,_} <- maps:get(nif_modules,Snap)],
          io_lib:format("| ~s | ~s |~n",[atom_to_list(Name),string:join(Mods,", ")])
      end || {Name,D} <- Data],
     "\nThe full declared function lists are in the `snapshot-<scenario>-stop.term` "
     "files and [nifs.csv](nifs.csv).\n\n"].

port_section(Data) ->
    ["| Scenario | Opened port names (call counts) | `os:cmd/1` calls |\n|---|---|---:|\n",
     [begin
          Opens = maps:get(port_opens,D),
          Names = lists:foldl(fun([PortName|_],Acc)->
                                      S = lists:flatten(io_lib:format("~p",[PortName])),
                                      maps:update_with(S,fun(N)->N+1 end,1,Acc)
                              end,#{},Opens),
          Calls = string:join([lists:flatten(io_lib:format("`~s` x ~B",[P,N])) ||
                                  {P,N} <- lists:sort(maps:to_list(Names))],", "),
          OsCmd = lists:sum([N || {"os","cmd",1,N,_} <- maps:get(rows,D)]),
          io_lib:format("| ~s | ~s | ~B |~n",
                        [atom_to_list(Name),case Calls of "" -> "none"; _ -> Calls end,OsCmd])
      end || {Name,D} <- Data],
     "\n[Raw port open arguments](port-opens-mix.term) show the exact driver "
     "or executable requested. No `spawn_executable` or `os:cmd/1` call was "
     "observed in this Mix run. The boot `udp_inet` open matches "
     "`inet_config:set_hostname/0`, which opens a temporary UDP socket; its "
     "source falls back to `nohost` if the open fails. The stop snapshots "
     "list surviving ports.\n\n"].

shipped(Dir) ->
    {ok,Bin} = file:read_file(filename:join(Dir,"bif-inventory.csv")),
    [_|Lines] = string:split(binary_to_list(Bin),"\n",all),
    Rows = [string:split(L,",",all) || L <- Lines,L =/= ""],
    Spec = length([ok || [_,_,_,"true",_,_,_] <- Rows]),
    Imported = length([ok || [_,_,_,_,"true",_,_] <- Rows]),
    Extra = length([ok || [_,_,_,"false","true",_,_] <- Rows]),
    Mods = lists:usort([M || [M|_] <- Rows]),
    [io_lib:format("The complete shipped inventory has **~B `bif.tab` entries**, "
                   "**~B imported builtins**, and **~B imported builtins outside `bif.tab`**. "
                   "There are **~B NIF functions** found by declarations or runtime discovery. "
                   "See [bif-inventory.csv](bif-inventory.csv), [static.csv](static.csv), "
                   "[nifs.csv](nifs.csv), and [static-summary.md](static-summary.md).\n\n",
                   [Spec,Imported,Extra,nif_count(Dir)]),
     "| BIF module | Inventory entries |\n|---|---:|\n",
     [io_lib:format("| `~s` | ~B |~n",[M,length([ok || [M0|_] <- Rows,M0 =:= M])]) || M <- Mods],"\n"].

nif_count(Dir) ->
    {ok,Bin} = file:read_file(filename:join(Dir,"nifs.csv")),
    length([L || L <- tl(string:split(binary_to_list(Bin),"\n",all)),L =/= ""]).

bench_imports(Root,Dir) ->
    Path = filename:join([Root,"tmp","census","ebin","bench.beam"]),
    {ok,{bench,Chunks}} = beam_lib:chunks(Path,[imports]),
    {ok,InventoryBin} = file:read_file(filename:join(Dir,"bif-inventory.csv")),
    [_|InventoryLines] = string:split(binary_to_list(InventoryBin),"\n",all),
    Spec = maps:from_list([{{M,F,list_to_integer(A)},true} ||
                           L <- InventoryLines,L =/= "",
                           [M,F,A,"true",_,_,_] <- [string:split(L,",",all)]]),
    All = lists:usort(proplists:get_value(imports,Chunks)),
    Rows = [{M,F,A,case erlang:is_builtin(M,F,A) of true -> "bif";
                  false -> case maps:is_key({atom_to_list(M),atom_to_list(F),A},Spec) of
                               true -> "bif_tab"; false -> "erlang" end end} ||
               {M,F,A} <- All],
    Csv = ["module,function,arity,kind\n" |
           [io_lib:format("~s,~s,~B,~s~n",[M,F,A,K]) ||
               {M0,F0,A,K} <- Rows,M <- [atom_to_list(M0)],F <- [atom_to_list(F0)]]],
    ok = file:write_file(filename:join(Dir,"bench-imports.csv"),Csv),
    [R || R={_,_,_,K} <- Rows,K =/= "erlang"].

static_coverage(Dir,BenchImports) ->
    {ok,ModsBin} = file:read_file(filename:join(Dir,"boot-modules.csv")),
    {ok,BootBin} = file:read_file(filename:join(Dir,"boot-imports.csv")),
    BootMods = length([L || L <- tl(string:split(binary_to_list(ModsBin),"\n",all)),L =/= ""]),
    [_|BootLines] = string:split(binary_to_list(BootBin),"\n",all),
    BootBifs = lists:usort([{M,F,A} || L <- BootLines,L =/= "",
                            [_,M,F,A,K] <- [string:split(L,",",all)],
                            lists:prefix("bif",K)]),
    BenchList = string:join([lists:flatten(io_lib:format("`~s:~s/~B`",[M,F,A])) ||
                                {M0,F0,A,_} <- BenchImports,
                                M <- [atom_to_list(M0)],F <- [atom_to_list(F0)]],", "),
    io_lib:format("The direct benchmark BEAM imports include **~B BIF candidates**: ~s. "
                  "This catches arithmetic, `element/2`, and `math:sqrt/1` even when call "
                  "tracing sees no event. See [bench-imports.csv](bench-imports.csv).\n\n"
                  "The default `start.script` names **~B preloaded, prim-loaded, or kernel "
                  "process modules**. Their imports contain **~B distinct BIF candidates**. "
                  "These are a conservative early-boot queue, not an executed-call count. "
                  "See [boot-modules.csv](boot-modules.csv) and "
                  "[boot-imports.csv](boot-imports.csv), including `init`, "
                  "`erl_prim_loader`, and `code_server`.\n\n",
                  [length(BenchImports),BenchList,BootMods,length(BootBifs)]).

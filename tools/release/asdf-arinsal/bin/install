#!/usr/bin/env bash
set -euo pipefail

: "${ASDF_INSTALL_PATH:?asdf did not set ASDF_INSTALL_PATH}"
: "${ASDF_DOWNLOAD_PATH:?asdf did not set ASDF_DOWNLOAD_PATH}"
if [ ! -x "$ASDF_DOWNLOAD_PATH/bin/arinsal" ] || [ ! -x "$ASDF_DOWNLOAD_PATH/bin/erl" ]; then
    echo "arinsal: verified distribution is missing its launcher binaries" >&2
    exit 1
fi
mkdir -p "$ASDF_INSTALL_PATH"
cp -R "$ASDF_DOWNLOAD_PATH/." "$ASDF_INSTALL_PATH/"

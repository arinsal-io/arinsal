#!/usr/bin/env escript
%%! -noshell
main([Path]) ->
    RemoteNode = <<119,14,"remote@fixture">>,
    RemotePid = binary_to_term(<<131,88,RemoteNode/binary,0,0,1,2,0,0,0,3,0,0,0,4>>),
    RemotePort = binary_to_term(<<131,120,RemoteNode/binary,0,0,0,0,1,2,3,4,0,0,0,4>>),
    RemoteRef = binary_to_term(<<131,90,0,3,RemoteNode/binary,0,0,0,4,0,0,0,1,0,0,0,2,0,0,0,3>>),
    Integers = [0,1,255,256,-1,-256,1 bsl 27,-(1 bsl 27),1 bsl 31,-(1 bsl 31),1 bsl 59,-(1 bsl 59),1 bsl 63,-(1 bsl 63),1 bsl 64,-(1 bsl 64),1 bsl 2048,-(1 bsl 2048)],
    Floats = [0.0,-0.0,1.0,-1.0,1.2345678901234567,1.0e100,5.0e-324,1.7976931348623157e308],
    Atoms = ['',ok,true,false,abc,'é','привіт','🦀',list_to_atom(lists:duplicate(255,$x))],
    Lists = [[],[1],[0,255,256],[1,2,3],[1|2],[1,2|3],lists:seq(0,255),lists:duplicate(65535,97),lists:duplicate(65536,97)],
    Binaries = [binary:copy(<<42>>,N) || N <- lists:seq(0,300)],
    Bits = [<<I:N>> || N <- lists:seq(1,7), I <- [0,(1 bsl N)-1]],
    Tuples = [list_to_tuple(lists:seq(1,N)) || N <- [0,1,2,32,255,256,300]],
    Maps = [#{},#{a=>1},#{z=>1,a=>2},maps:from_list([{N,N*2} || N <- lists:seq(1,32)]),maps:from_list([{N,N*2} || N <- lists:seq(1,33)]),maps:from_list([{N,N*2} || N <- lists:seq(1,1000)]),#{a=>#{b=>#{c=>[1,2,3]}},3=>2,1.0=>3,1=>4}],
    X = 17,
    Funs = [fun lists:map/2,fun(Y) -> X+Y end],
    Identities = [self(),make_ref(),hd(erlang:ports()),RemotePid,RemotePort,RemoteRef],
    FreshZ = list_to_atom("zz_arinsal_etf_fresh_20260925"),
    FreshA = list_to_atom("aa_arinsal_etf_fresh_20260925"),
    FreshMap = maps:from_list([{FreshZ,1},{FreshA,2}]),
    MixedKeys = [0,0.0,1,1.0,-1,abc,[],[1],{},#{},<<>>,<<1:1>>,self(),make_ref(),hd(erlang:ports()),fun lists:map/2],
    MixedMap = maps:from_list(lists:zip(MixedKeys, lists:seq(1,length(MixedKeys)))),
    NativeRecords = [records:create(test_etf, empty, [], #{is_exported => false}), records:create(test_etf, sample, [{z,1},{a,[1,2]},{emoji,'🦀'}], #{is_exported => true})],
    Terms = Integers ++ Floats ++ Atoms ++ Lists ++ Binaries ++ Bits ++ Tuples ++ Maps ++ Identities ++ Funs ++ NativeRecords ++ [MixedMap,FreshMap],
    Enc = fun(T) -> [term_to_binary(T),term_to_binary(T,[{minor_version,0}]),term_to_binary(T,[{minor_version,1}]),term_to_binary(T,[compressed]),term_to_binary(T,[{compressed,9}]),term_to_binary(T,[deterministic])] end,
    Records = lists:zip(lists:seq(0,length(Terms)-1),[Enc(T) || T <- Terms]),
    Body = [begin Bins = [<<(byte_size(B)):32,B/binary>> || B <- Bs], <<Id:32,(iolist_to_binary(Bins))/binary>> end || {Id,Bs} <- Records],
    ok = file:write_file(Path, [<<(length(Records)):32>>,Body]),
    io:format("~B terms x 6 options~n",[length(Records)]).

+// EXPERIMENT (ingest-profile): `<arch>-apple-darwin<uname -r>` like ERTS's
+// configure triple on macOS (e.g. "aarch64-apple-darwin24.6.0").
+fn system_architecture() -> String {
+    let arch = if cfg!(target_arch = "aarch64") { "aarch64" } else { std::env::consts::ARCH };
+    // SAFETY: uname fills a caller-owned struct and retains no pointers.
+    let release = unsafe {
+        let mut name: libc::utsname = std::mem::zeroed();
+        if libc::uname(&mut name) == 0 {
+            std::ffi::CStr::from_ptr(name.release.as_ptr()).to_string_lossy().into_owned()
+        } else {
+            String::new()
+        }
+    };
+    if cfg!(target_os = "macos") {
+        format!("{arch}-apple-darwin{release}")
+    } else {
+        format!("{arch}-unknown-{}-gnu", std::env::consts::OS)
+    }
+}
